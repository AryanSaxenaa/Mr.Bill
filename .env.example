# LLM provider for live agent on /app/request (optional; auto-detected from keys)
# LLM_PROVIDER=openrouter | deepseek | openai
# Default when unset: OpenRouter if OPENROUTER_API_KEY, else DeepSeek if DEEPSEEK_API_KEY, else OpenAI if OPENAI_API_KEY

# --- OpenRouter (https://openrouter.ai/api/v1) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
# Optional OpenRouter attribution (recommended)
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=Mr.Bill

# --- DeepSeek (https://api.deepseek.com) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- OpenAI (default API) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: used as OpenRouter HTTP-Referer when OPENROUTER_HTTP_REFERER is unset
# NEXT_PUBLIC_APP_URL=http://localhost:3847

# --- AgentMail (real RFQ email) ---
# Get a key at https://agentmail.to — never commit the real value
AGENTMAIL_API_KEY=
# Optional: reuse an existing inbox (otherwise created with clientId mrbill-procurement-v1)
# AGENTMAIL_INBOX_ID=

# Hackathon-safe: route all RFQs to your inbox; subject includes [Supplier: Name]
# MRBILL_RFQ_TO_EMAIL=you@example.com
