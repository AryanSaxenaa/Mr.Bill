# Mr.Bill: copy to .env.local (never commit secrets)

# --- LLM (optional live agent on /app/request) ---
# LLM_PROVIDER=openrouter | deepseek | openai
# Default when unset: OpenRouter if OPENROUTER_API_KEY, else DeepSeek, else OpenAI

# OpenRouter (https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_HTTP_REFERER=http://localhost:3847
# OPENROUTER_APP_TITLE=Mr.Bill

# DeepSeek (https://api.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Public app URL (OpenRouter referer fallback when OPENROUTER_HTTP_REFERER unset)
# NEXT_PUBLIC_APP_URL=http://localhost:3847

# --- SerpAPI (supplier discovery) ---
# https://serpapi.com - server-only; used by find_suppliers and POST /api/suppliers/search
SERPAPI_API_KEY=

# --- AgentMail (RFQ email) ---
# https://agentmail.to
AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX_ID=

# Hackathon-safe: route all RFQs to one inbox (subject includes [Supplier: …])
# MRBILL_RFQ_TO_EMAIL=you@example.com

# Production webhook: https://YOUR-RAILWAY-URL/api/webhooks/agentmail
